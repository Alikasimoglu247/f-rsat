# Yerel geliştirme değerleri; üretimde değiştirin. Gerçek sırları Git'e eklemeyin.
DATABASE_URL=postgresql://radar:radar_local_dev@127.0.0.1:5432/firsatradar?schema=public
TEST_DATABASE_URL=postgresql://radar:radar_local_dev@127.0.0.1:5432/firsatradar_test?schema=public
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_local_dev
POSTGRES_DB=firsatradar
APP_BASE_URL=http://127.0.0.1:3000
# İsteğe bağlı HTTP Basic auth; kullanıcı adı radar. Dışarı açmadan önce ayarlayın.
APP_ACCESS_TOKEN=
DAILY_CRON=0 9 * * *
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Kullanım hakkına sahip olduğunuz sağlayıcı. endpoint aynı JSON sözleşmesini döndürmeli.
AUTHORIZED_FEED_URL=
AUTHORIZED_FEED_HOST=
AUTHORIZED_FEED_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# M2 Gmail: kullanıcı OAuth onayı ve etiket/gönderici seçimi olmadan e-posta alınmaz.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/email/gmail/callback
# 32 bayt rastgele anahtarın base64url gösterimi; güvenli sunucu ortamında tutun.
GMAIL_TOKEN_ENCRYPTION_KEY=
# İsteğe bağlı şifreli token dosyası. Web ve scheduler aynı yolu kullanmalı.
GMAIL_TOKEN_STORE=
# Üretimde mutlak token yolu kalıcı volume üzerinde olmalı; yalnızca gerçekten bağladıktan sonra true yapın.
GMAIL_TOKEN_STORE_PERSISTENT=false

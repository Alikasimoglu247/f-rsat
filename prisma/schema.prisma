generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  EV
  ARABA
  ARSA
  TARLA
}

model Listing {
  id              String                 @id @default(cuid())
  title           String
  category        Category
  province        String
  district        String
  neighborhood    String?
  transactionType String?
  price           Decimal                @db.Decimal(18, 2)
  sourceUrl       String?
  externalId      String?
  identityKey     String
  identityVersion Int                    @default(2)
  identityStatus  String                 @default("ACTIVE")
  sourceId        String
  source          ListingSource          @relation(fields: [sourceId], references: [id])
  isDemo          Boolean                @default(false)
  provenance      Json
  collectedAt     DateTime               @default(now())
  lastObservedAt  DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  property        PropertyDetails?
  vehicle         VehicleDetails?
  land            LandDetails?
  prices          ListingPriceHistory[]
  assessment      OpportunityAssessment?
  comparableLinks ComparableListing[]    @relation("assessed")
  comparedAs      ComparableListing[]    @relation("comparable")
  watch           Watchlist?
  notifications   Notification[]

  @@unique([sourceId, externalId])
  @@unique([sourceId, sourceUrl])
  @@index([identityKey])
  @@index([category, province, district])
}

model ListingSource {
  id             String          @id
  name           String
  method         String
  authorization  String
  accessStatus   String          @default("DISCONNECTED")
  lastSuccessAt  DateTime?
  lastError      String?
  freshnessHours Int             @default(168)
  categories     Category[]
  listings       Listing[]
  logs           SourceSyncLog[]
  imports        ImportJob[]
  reviews        ListingReview[]
  regions        String[]        @default([])
  lastNewCount   Int             @default(0)
}

model ListingPriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(18, 2)
  observedAt DateTime @default(now())
  provenance Json

  @@index([listingId, observedAt])
}

model PropertyDetails {
  listingId      String   @id
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sizeM2         Decimal? @db.Decimal(12, 2)
  netM2          Decimal? @db.Decimal(12, 2)
  grossM2        Decimal? @db.Decimal(12, 2)
  propertyType   String?
  rooms          String?
  buildingAge    Int?
  condition      String?
  legalStatus    String?
  earthquakeInfo String?
}

model VehicleDetails {
  listingId        String  @id
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  make             String?
  model            String?
  trim             String?
  modelYear        Int?
  mileage          Int?
  fuel             String?
  transmission     String?
  damageHistory    String?
  bodyType         String?
  bodyTypeVerified Boolean @default(false)
  bodyTypeEvidence String?
}

model LandDetails {
  listingId                String   @id
  listing                  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sizeM2                   Decimal? @db.Decimal(12, 2)
  classification           String?
  zoning                   String?
  roadAccess               String?
  parcelNumber             String?
  sharedOwnership          String?
  agriculturalRestrictions String?
}

model SearchProfile {
  id              String     @id @default(cuid())
  name            String
  category        Category?
  province        String?
  district        String?
  minPrice        Decimal?   @db.Decimal(18, 2)
  maxPrice        Decimal?   @db.Decimal(18, 2)
  pilotKey        String?    @unique
  categories      Category[] @default([])
  provinces       String[]   @default([])
  bodyTypes       String[]   @default([])
  fuels           String[]   @default([])
  transactionType String?
  trackPriceDrops Boolean    @default(false)
  mailLabelIds    String[]   @default([])
  mailSenders     String[]   @default([])
  alerts          Alert[]
  createdAt       DateTime   @default(now())
}

model ComparableListing {
  id              String  @id @default(cuid())
  listingId       String
  listing         Listing @relation("assessed", fields: [listingId], references: [id], onDelete: Cascade)
  comparableId    String
  comparable      Listing @relation("comparable", fields: [comparableId], references: [id], onDelete: Cascade)
  normalizedPrice Decimal @db.Decimal(18, 2)
  reason          String

  @@unique([listingId, comparableId])
}

model OpportunityAssessment {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  medianPrice        Decimal? @db.Decimal(18, 2)
  rangeLow           Decimal? @db.Decimal(18, 2)
  rangeHigh          Decimal? @db.Decimal(18, 2)
  relativeDifference Decimal? @db.Decimal(10, 4)
  priceChange        Decimal? @db.Decimal(10, 4)
  sampleCount        Int
  confidence         String
  score              Int?
  riskFlags          Json
  explanation        String
  assessedAt         DateTime @default(now())
}

model Alert {
  id            String         @id @default(cuid())
  profileId     String
  profile       SearchProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  minScore      Int            @default(70)
  enabled       Boolean        @default(true)
  notifications Notification[]
}

model Notification {
  id        String    @id @default(cuid())
  dedupKey  String    @unique
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  alertId   String?
  alert     Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  title     String
  body      String
  channel   String    @default("IN_APP")
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model ImportJob {
  id          String        @id @default(cuid())
  sourceId    String
  source      ListingSource @relation(fields: [sourceId], references: [id])
  format      String
  status      String
  total       Int           @default(0)
  inserted    Int           @default(0)
  updated     Int           @default(0)
  duplicates  Int           @default(0)
  reviewed    Int           @default(0)
  errors      Json
  createdAt   DateTime      @default(now())
  completedAt DateTime?
}

model SourceSyncLog {
  id        String        @id @default(cuid())
  sourceId  String
  source    ListingSource @relation(fields: [sourceId], references: [id])
  status    String
  attempts  Int           @default(1)
  message   String
  createdAt DateTime      @default(now())
}

model Watchlist {
  listingId String   @id
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AppSettings {
  id                       String  @id @default("personal")
  telegramEnabled          Boolean @default(false)
  emailEnabled             Boolean @default(false)
  minScore                 Int     @default(70)
  includeDemoNotifications Boolean @default(false)
}

model AnalysisRun {
  id          String       @id
  status      String
  attempts    Int          @default(1)
  processed   Int          @default(0)
  errors      Json
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  report      DailyReport?
}

model ListingReview {
  id           String        @id @default(cuid())
  sourceId     String
  source       ListingSource @relation(fields: [sourceId], references: [id])
  kind         String
  status       String        @default("PENDING")
  reason       String
  dedupKey     String        @unique
  input        Json
  candidateIds Json
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
}

model MailboxConnection {
  id            String    @id @default("personal")
  status        String    @default("DISCONNECTED")
  accountHash   String?
  labelIds      String[]  @default([])
  senders       String[]  @default([])
  lookbackDays  Int       @default(7)
  lastSuccessAt DateTime?
  lastError     String?
  retryAfter    DateTime?
  scanAfter     DateTime?
  scanBefore    DateTime?
  pageToken     String?
  lastFetched   Int       @default(0)
  lastImported  Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

model EmailMessage {
  id             String                 @id @default(cuid())
  contentHash    String                 @unique
  deliveryKey    String?                @unique
  transport      String
  sender         String
  subject        String
  receivedAt     DateTime?
  providerId     String?
  status         String
  proposals      Json
  errors         Json
  templateIds    String[]               @default([])
  inserted       Int                    @default(0)
  updated        Int                    @default(0)
  duplicates     Int                    @default(0)
  reviewed       Int                    @default(0)
  createdAt      DateTime               @default(now())
  processedAt    DateTime?
  seenViaGmailAt DateTime?
  deliveries     EmailDelivery[]
  gmailLabelIds  String[]               @default([])
  pilotIds       String[]               @default([])
  corrections    EmailFieldCorrection[]
}

model EmailFieldCorrection {
  id            String       @id @default(cuid())
  messageId     String
  message       EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  proposalIndex Int
  before        Json
  after         Json
  evidenceNote  String
  createdAt     DateTime     @default(now())
}

model SchedulerHealth {
  id              String    @id @default("personal")
  instanceId      String?
  status          String
  lastHeartbeatAt DateTime
  lastTickAt      DateTime?
  lastResult      String?
  schedule        String
  timezone        String    @default("Europe/Istanbul")
}

model EmailDelivery {
  key       String       @id
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model EmailTemplate {
  id              String    @id
  providerId      String
  sender          String
  parserVersion   String
  sampleMessageId String
  status          String    @default("USER_APPROVED")
  confirmedAt     DateTime  @default(now())
  liveValidatedAt DateTime?
}

model OAuthAttempt {
  stateHash String    @id
  expiresAt DateTime
  usedAt    DateTime?
}

model DailyReport {
  runId      String      @id
  run        AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  body       String
  listingIds String[]
  createdAt  DateTime    @default(now())
}
